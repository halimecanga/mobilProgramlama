<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".sevgili">

    <TextView
        android:id="@+id/textViewSevgililer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sevgililer Günü Mesajları"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#E91E63"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/button10"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/sevgilimesaj1"
        android:contentDescription="@string/sevgilimesaj1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewSevgililer"
        android:backgroundTint="#FF4081"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button11"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/sevgilimesaj2"
        android:contentDescription="@string/sevgilimesaj2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button10"
        android:backgroundTint="#FF4081"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button18"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/sevgilimesaj3"
        android:contentDescription="@string/sevgilimesaj3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button11"
        android:backgroundTint="#FF4081"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button19"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/sevgilimesaj4"
        android:contentDescription="@string/sevgilimesaj4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button18"
        android:backgroundTint="#FF4081"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button20"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/sevgilimesaj5"
        android:contentDescription="@string/sevgilimesaj5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button19"
        android:backgroundTint="#FF4081"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button21"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/sevgilimesaj6"
        android:contentDescription="@string/sevgilimesaj6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button20"
        android:backgroundTint="#FF4081"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        app:srcCompat="@drawable/sevgililergunugorsel1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button21"
        android:layout_marginTop="16dp"
        android:contentDescription="Sevgililer Günü Görseli 1" />

    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        app:srcCompat="@drawable/sevgililergunugorsel4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView5"
        android:layout_marginTop="8dp"
        android:contentDescription="Sevgililer Günü Görseli 4" />

    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        app:srcCompat="@drawable/sevgililergunugorsel2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView8"
        android:layout_marginTop="8dp"
        android:contentDescription="Sevgililer Günü Görseli 2" />

</androidx.constraintlayout.widget.ConstraintLayout>