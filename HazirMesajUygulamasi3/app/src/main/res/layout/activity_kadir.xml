<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".kadir">

    <TextView
        android:id="@+id/textViewKadir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kadir Gecesi Mesajları"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/button58"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:text="@string/kadirmesaj1"
        android:contentDescription="@string/kadirmesaj1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewKadir"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button59"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:text="@string/kadirmesaj2"
        android:contentDescription="@string/kadirmesaj2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button58"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button60"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:text="@string/kadirmesaj3"
        android:contentDescription="@string/kadirmesaj3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button59"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button61"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:text="@string/kadirmesaj4"
        android:contentDescription="@string/kadirmesaj4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button60"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button62"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:text="@string/kadirmesaj5"
        android:contentDescription="@string/kadirmesaj5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button61"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button63"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:text="@string/kadirmesaj6"
        android:contentDescription="@string/kadirmesaj6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button62"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <ImageView
        android:id="@+id/imageView13"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/kadirgorsel1"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button63"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>

    <ImageView
        android:id="@+id/imageView16"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/kadirgorsel2"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView13"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>

    <ImageView
        android:id="@+id/imageView17"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:srcCompat="@drawable/kadirgorsel3"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView16"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>