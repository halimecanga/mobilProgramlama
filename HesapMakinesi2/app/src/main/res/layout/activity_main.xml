<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Ad Giriş Alanı -->
    <EditText
        android:id="@+id/editTextAd"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Ad"
        android:inputType="textPersonName"
        android:padding="12dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Soyad Giriş Alanı -->
    <EditText
        android:id="@+id/editTextSoyad"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Soyad"
        android:inputType="textPersonName"
        android:padding="12dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/editTextAd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Yaş Giriş Alanı -->
    <EditText
        android:id="@+id/editTextYas"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Yaş"
        android:inputType="number"
        android:padding="12dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/editTextSoyad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Şehir Giriş Alanı -->
    <EditText
        android:id="@+id/editTextSehir"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Şehir"
        android:inputType="text"
        android:padding="12dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/editTextYas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Kayıt Ekle Butonu -->
    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Kayıt Ekle"
        android:minWidth="100dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/editTextSehir"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Kayıtları Göster Butonu -->
    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Kayıtları Göster"
        android:minWidth="100dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/button"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Kayıt Sil Butonu -->
    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Kayıt Sil"
        android:minWidth="100dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/button2"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Ek Buton -->
    <Button
        android:id="@+id/button4"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Button"
        android:minWidth="100dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/button3"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bilgi Metni -->
    <TextView
        android:id="@+id/textViewBilgiler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/button4"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Kayıtların Gösterileceği Metin -->
    <TextView
        android:id="@+id/veriTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Kayıtlar burada gösterilecek"
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/textViewBilgiler"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>