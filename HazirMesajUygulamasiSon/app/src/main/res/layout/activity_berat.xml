<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".berat">

    <TextView
        android:id="@+id/textViewBerat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Berat Kandili Mesajları"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/button40"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/beratmesaj1"
        android:contentDescription="@string/beratmesaj1"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewBerat"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button41"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/beratmesaj2"
        android:contentDescription="@string/beratmesaj2"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button40"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button42"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/beratmesaj3"
        android:contentDescription="@string/beratmesaj3"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button41"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button43"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/beratmesaj4"
        android:contentDescription="@string/beratmesaj4"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button42"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button44"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/beratmesaj5"
        android:contentDescription="@string/beratmesaj5"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button43"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <Button
        android:id="@+id/button45"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/beratmesaj6"
        android:contentDescription="@string/beratmesaj6"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button44"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"/>

    <ImageView
        android:id="@+id/imageView11"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        app:srcCompat="@drawable/beratkandiligorsel1"
        android:contentDescription="Berat Kandili Görseli 1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button45"
        android:layout_marginTop="16dp"/>

    <ImageView
        android:id="@+id/imageView14"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        app:srcCompat="@drawable/beratkandiligorsel3"
        android:contentDescription="Berat Kandili Görseli 3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView11"
        android:layout_marginTop="8dp"/>

    <ImageView
        android:id="@+id/imageView15"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        app:srcCompat="@drawable/beratkandiligorsel5"
        android:contentDescription="Berat Kandili Görseli 5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView14"
        android:layout_marginTop="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>